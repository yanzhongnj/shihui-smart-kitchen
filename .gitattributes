# 统一换行符策略，避免 Windows / Linux 协作时产生整文件差异
* text=auto

# Windows 批处理必须使用 CRLF，否则可能无法执行
*.bat text eol=crlf
*.cmd text eol=crlf

# Shell 脚本必须使用 LF
*.sh  text eol=lf

# 二进制资源不做换行符转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.jar binary
*.apk binary
*.aab binary
*.woff binary
*.woff2 binary
*.ttf binary
*.mp4 binary
