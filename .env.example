# ===== 密钥与环境配置（禁止提交真实值）=====
# 复制为 .env / 生产环境 systemd EnvironmentFile，填入真实值后使用
# ⚠️ 任何情况下不要将本文件填写后的版本提交到版本库

# ---------- 数据库 ----------
MYSQL_PASSWORD=change-me

# ---------- 安全 ----------
# 生成：openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-string-of-at-least-256-bits

# ---------- LLM（步骤抽取 / 对话 / 菜单生成）----------
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ---------- 阿里云百炼 DashScope（拍照识菜 Qwen-VL / 语音讲解 Qwen3-TTS / 通义万相）----------
# 说明：变量名 ALIYUN_ASR_APP_KEY 为历史沿用，实际承载 DashScope Key
# DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# ALIYUN_ASR_APP_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ---------- 火山方舟 Seedance（可选：视频生成）----------
# SEEDANCE_API_KEY=
# SEEDANCE_ENDPOINT=
# SEEDANCE_QUERY_ENDPOINT=
# SEEDANCE_MODEL=

# ---------- 智能厨电中控（预留，未实现）----------
# TUYA_CLIENT_ID=
# TUYA_CLIENT_SECRET=
# MIJIA_CLIENT_ID=
# MIJIA_CLIENT_SECRET=

# ---------- 存储与路径 ----------
VIDEO_STORAGE_PATH=./data/video-steps
PIPELINE_DIR=../video-step-locator
PYTHON_PATH=python
FFMPEG_PATH=ffmpeg
YTDLP_PATH=yt-dlp
APK_DIR=data/apk

# ---------- 处理设备 ----------
# cpu | cuda（需安装 CUDA 版 PyTorch）
PROCESSING_DEVICE=cpu

# ---------- 开源内容源 ----------
HOWTOCOOK_REPO=https://github.com/Anduin2017/HowToCook.git
HOWTOCOOK_DIR=data/howtocook

# ---------- 模型下载镜像（中国大陆可选）----------
HF_ENDPOINT=https://hf-mirror.com

# ---------- 仅本机监听（生产建议开启，由 Nginx 反代）----------
# SERVER_ADDRESS=127.0.0.1
